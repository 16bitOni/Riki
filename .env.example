# ---- database
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# ---- AWS Bedrock (uses your normal AWS credentials: `aws configure`, env vars, or an IAM role)
AWS_REGION=us-east-1
# Check the exact IDs available to you in the Bedrock console (Model catalog / Inference profiles).
# The "us." prefix is a cross-region inference profile; use "apac." / "eu." to match your region.
MAIN_MODEL_ID=global.anthropic.claude-sonnet-4-6
FAST_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- raw conversation archive: "local" (a folder, for development) or "s3"
STORAGE_BACKEND=local
LOCAL_ARCHIVE_DIR=data/archive
S3_BUCKET=

# ---- who you are (single-user mode; a row is created on first start)
USER_NAME=Subhadip
USER_TIMEZONE=Asia/Kolkata

# ---- optional tools
TAVILY_API_KEY=
GOOGLE_CLIENT_SECRET_PATH=secrets/google_client.json
GOOGLE_TOKEN_PATH=secrets/google_token.json

# ---- Telegram: chat with the agent from your phone (token from @BotFather)
# Leave TELEGRAM_ALLOWED_CHAT_IDS empty on first run, message the bot, and it replies with your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ENABLED=false         # run a second instance (a dev server, a test) WITHOUT the bot: two pollers fight over messages

# ---- Observability dashboard (http://localhost:8000/dashboard)
# TELEMETRY_ENABLED=true
# TELEMETRY_RETENTION_DAYS=30          # older traces are deleted automatically
# TELEMETRY_STORE_CONTENT=true         # false: record timings and sizes only, never message or memory text
# Set API_KEY (below) to protect the dashboard's data: it then asks for the key in the browser.

# ---- optional: if set, every request must send header  X-API-Key: <value>
API_KEY=

# --- Session context (checkpointing gives the agent a real context window across turns) ---
# SESSION_TIMEOUT_HOURS=24         # inactivity before a session is auto-closed and learnings extracted
# SESSION_MAX_MESSAGES=100         # trim older messages beyond this to cap token usage
# SESSION_GUIDE_LIMIT=5            # how many recent session guides to inject into the prompt

# --- Retrieval tuning (defaults are starting guesses; measure with `python -m scripts.memory_admin eval`) ---
# MIN_SIMILARITY=0.3
# GRAPH_MAX_HOPS=3
# WEIGHT_KEYWORD=1.0
# WEIGHT_SEMANTIC=1.0
# WEIGHT_GRAPH=0.7
# WEIGHT_TIME=0.5
# IMPORTANCE_WEIGHT=0.05
# RERANK=off                 # "llm" adds one cheap model call per message
# DEDUP_TRIGRAM_THRESHOLD=0.85
# DEDUP_VECTOR_THRESHOLD=0.93
# REEMBED_CONCURRENCY=5

# --- Desktop Operator (agent that controls this computer). OFF by default. ---
# OPERATOR_ENABLED=false         # true also needs API_KEY, because its endpoints can drive this PC
# OPERATOR_ROOTS=C:\Projects\memory-agent      # comma separated: the only folders it may read/edit/run in
# OPERATOR_MAX_STEPS=40
# OPERATOR_COMMAND_TIMEOUT=300
# OPERATOR_APPROVAL_TIMEOUT=600
# OPERATOR_AUTO_APPROVE_EDITS=false
